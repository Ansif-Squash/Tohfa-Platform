          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "  pm.collectionVariables.set(\"farmerToken\", jsonData.accessToken);",
                  "  pm.environment.set(\"farmerToken\", jsonData.accessToken);",
                  "}"
