{
  /* React Native uses Metro + Babel, so tsc is a typechecker only (--noEmit).
     Strictness deliberately matches tsconfig.base.json. */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "types": ["react"],
    "baseUrl": ".",
    "paths": {
      "@tohfa/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@tohfa/design-tokens": ["../../packages/design-tokens/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "index.js"],
  "exclude": ["node_modules", "android", "ios"]
}
