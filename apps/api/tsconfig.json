{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["node"],
    "lib": ["ES2022"],
    "paths": {
      "@tohfa/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@tohfa/shared-types/*": ["../../packages/shared-types/src/*"],
      "@tohfa/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@tohfa/design-tokens/*": ["../../packages/design-tokens/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"],
  "references": [
    { "path": "../../packages/shared-types" },
    { "path": "../../packages/design-tokens" }
  ]
}
